# EXAMPLE ONLY — not automatically loaded by Flask. Never commit your real copy.
# Use a secret manager / private service environment. Do not paste secrets into chat.
ORIENTAL24_MODE=production
# REQUIRED: generate a random persistent key, at least 32 characters. Empty fails closed.
SECRET_KEY=
# REQUIRED: absolute path, distinct from demo; parent directory must have permissions 0700.
DB_PATH=/var/lib/oriental24/app.sqlite
# REQUIRED: replace with your real hostname; no scheme, slash or wildcard.
ORIENTAL24_TRUSTED_HOSTS=
# Keep zero unless the backend is network-isolated behind exactly this many trusted proxies.
ORIENTAL24_PROXY_HOPS=0
ORIENTAL24_PUBLIC_REGISTRATION=0
ORIENTAL24_SESSION_HOURS=12
ORIENTAL24_IDLE_MINUTES=30
